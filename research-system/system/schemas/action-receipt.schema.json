{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis-tree.local/action-receipt.schema.json",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "nonempty": {"type": "string", "minLength": 1},
    "nullable_nonempty": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
    "dispatch_ref": {"type": "string", "pattern": "^tree#L4/dispatch#d-[1-9][0-9]*(?:\\.[1-9][0-9]*)*-[1-9][0-9]*$"},
    "runtime_output": {"type": "object", "additionalProperties": false, "required": ["slot", "relative_path", "sha256", "bytes"], "properties": {"slot": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 0}}},
    "repository_output": {"type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256"], "properties": {"kind": {"enum": ["plan", "report", "unit", "qa", "subgoal", "dispatch", "interrupt", "ratification-annotation", "issue-queue", "adjudication"]}, "ref": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "role_packet": {"type": "object", "additionalProperties": false, "required": ["version", "sha256"], "properties": {"version": {"const": "v1"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "payload_rerank": {"type": "object", "additionalProperties": false, "required": ["source_issue_queue_schema_version", "source_issue_queue_sha256", "source_issue_queue_canonical_json", "entries"], "properties": {"source_issue_queue_schema_version": {"$ref": "#/$defs/nonempty"}, "source_issue_queue_sha256": {"$ref": "#/$defs/sha"}, "source_issue_queue_canonical_json": {"type": "string", "minLength": 2, "pattern": "\\n$"}, "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["issue_ref", "rank", "triage_note", "date"], "properties": {"issue_ref": {"type": "string", "pattern": "^issue#I-[1-9][0-9]*$"}, "rank": {"type": "integer", "minimum": 1}, "triage_note": {"$ref": "#/$defs/nullable_nonempty"}, "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}, "uniqueItems": true}}},
    "payload_plan": {"type": "object", "additionalProperties": false, "required": ["dispatch_ref", "plan_output", "junior_tasks", "checker_task"], "properties": {"dispatch_ref": {"$ref": "#/$defs/dispatch_ref"}, "plan_output": {"$ref": "#/$defs/runtime_output"}, "junior_tasks": {"type": "array", "minItems": 1, "items": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/plan_task"}}, "checker_task": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/plan_task"}}},
    "payload_report": {"type": "object", "additionalProperties": false, "required": ["dispatch_ref", "report_output", "proposed_claims"], "properties": {"dispatch_ref": {"$ref": "#/$defs/dispatch_ref"}, "report_output": {"$ref": "#/$defs/runtime_output"}, "proposed_claims": {"type": "array", "items": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/proposal"}, "uniqueItems": true}}},
    "payload_junior": {"type": "object", "additionalProperties": false, "required": ["dispatch_ref", "artifact_outputs", "completion_status"], "properties": {"dispatch_ref": {"$ref": "#/$defs/dispatch_ref"}, "artifact_outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime_output"}, "uniqueItems": true}, "completion_status": {"enum": ["done", "failed", "skipped"]}}},
    "payload_checker": {"type": "object", "additionalProperties": false, "required": ["dispatch_ref", "qa_output", "verdict"], "properties": {"dispatch_ref": {"$ref": "#/$defs/dispatch_ref"}, "qa_output": {"$ref": "#/$defs/runtime_output"}, "verdict": {"enum": ["pass", "hold"]}}},
    "payload_verifier": {"type": "object", "additionalProperties": false, "required": ["dispatch_ref", "report_ref", "report_sha256", "report_action_ref", "report_attempt", "whole_report_verdict", "plan_conformance", "coverage", "claim_verdicts", "defects", "standing", "standing_note"], "properties": {"dispatch_ref": {"$ref": "#/$defs/dispatch_ref"}, "report_ref": {"type": "string", "pattern": "^tree#L4/report#d-[1-9][0-9]*(?:\\.[1-9][0-9]*)*-[1-9][0-9]*$"}, "report_sha256": {"$ref": "#/$defs/sha"}, "report_action_ref": {"type": "string", "pattern": "^action-receipt#AR-[1-9][0-9]*$"}, "report_attempt": {"const": 1}, "whole_report_verdict": {"enum": ["accepted", "bounced"]}, "plan_conformance": {"enum": ["conformant", "defective"]}, "coverage": {"enum": ["complete", "honestly-bounded", "defective"]}, "claim_verdicts": {"type": "array", "items": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/claim_verdict"}}, "defects": {"type": "array", "items": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/defect"}}, "standing": {"enum": ["untested", "supported", "weakened", "refuted", "contested"]}, "standing_note": {"$ref": "#/$defs/nullable_nonempty"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "action_id", "action_kind", "target_ref", "payload", "profile_id", "role_packet", "task_package_ref", "task_package_sha256", "verifier_fence_set_sha256", "runtime_id", "request_id", "binding_id", "lease_epoch", "session_id", "fence", "packet_sha256", "source_action_sha256", "outputs", "created_at"],
  "properties": {
    "schema_version": {"const": "hypothesis-tree-action-receipt/1.0.0"},
    "id": {"type": "string", "pattern": "^AR-[1-9][0-9]*$"},
    "action_id": {"$ref": "#/$defs/uuid"},
    "action_kind": {"enum": ["pc.route-subgoal", "pc.rerank-issue-queue", "pc.annotate-ratification", "pc.no-op", "director.create-dispatch", "director.raise-interrupt", "director.recall-dispatch", "senior.submit-plan", "senior.submit-report", "junior.return-unit-artifact", "checker.return-qa", "verifier.adjudicate-report"]},
    "target_ref": {"$ref": "#/$defs/nonempty"},
    "payload": {"type": "object"},
    "profile_id": {"enum": ["principal-coordinator-v1", "l4-director-v1", "senior-v1", "junior-v1", "checker-v1", "verifier-v1"]},
    "role_packet": {"$ref": "#/$defs/role_packet"},
    "task_package_ref": {"type": "string", "pattern": "^task-package#TP-[1-9][0-9]*$"},
    "task_package_sha256": {"$ref": "#/$defs/sha"},
    "verifier_fence_set_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "runtime_id": {"$ref": "#/$defs/uuid"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "binding_id": {"$ref": "#/$defs/uuid"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "session_id": {"$ref": "#/$defs/uuid"},
    "fence": {"$ref": "#/$defs/nonempty"},
    "packet_sha256": {"$ref": "#/$defs/sha"},
    "source_action_sha256": {"$ref": "#/$defs/sha"},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/repository_output"}, "uniqueItems": true},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "oneOf": [
    {"properties": {"action_kind": {"const": "pc.route-subgoal"}, "target_ref": {"type": "string", "pattern": "^issue#I-[1-9][0-9]*$"}, "profile_id": {"const": "principal-coordinator-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/payload_route"}}},
    {"properties": {"action_kind": {"const": "pc.rerank-issue-queue"}, "target_ref": {"const": "issue-queue#current"}, "profile_id": {"const": "principal-coordinator-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "#/$defs/payload_rerank"}}},
    {"properties": {"action_kind": {"const": "pc.annotate-ratification"}, "target_ref": {"type": "string", "pattern": "^ratification-item#RQ-[1-9][0-9]*$"}, "profile_id": {"const": "principal-coordinator-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/payload_annotation"}}},
    {"properties": {"action_kind": {"const": "pc.no-op"}, "target_ref": {"const": "pc#principal-coordinator"}, "profile_id": {"const": "principal-coordinator-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/payload_noop"}}},
    {"properties": {"action_kind": {"const": "director.create-dispatch"}, "target_ref": {"type": "string", "pattern": "^tree#L4/node#[1-9][0-9]*(?:\\.[1-9][0-9]*)*$"}, "profile_id": {"const": "l4-director-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/payload_create"}}},
    {"properties": {"action_kind": {"const": "director.raise-interrupt"}, "target_ref": {"type": "string", "pattern": "^subgoal#SG-[1-9][0-9]*$"}, "profile_id": {"const": "l4-director-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/payload_interrupt"}}},
    {"properties": {"action_kind": {"const": "director.recall-dispatch"}, "target_ref": {"$ref": "#/$defs/dispatch_ref"}, "profile_id": {"const": "l4-director-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "https://hypothesis-tree.local/producer-return.schema.json#/$defs/payload_recall"}}},
    {"properties": {"action_kind": {"const": "senior.submit-plan"}, "target_ref": {"$ref": "#/$defs/dispatch_ref"}, "profile_id": {"const": "senior-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "#/$defs/payload_plan"}}},
    {"properties": {"action_kind": {"const": "senior.submit-report"}, "target_ref": {"$ref": "#/$defs/dispatch_ref"}, "profile_id": {"const": "senior-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "#/$defs/payload_report"}}},
    {"properties": {"action_kind": {"const": "junior.return-unit-artifact"}, "target_ref": {"$ref": "#/$defs/dispatch_ref"}, "profile_id": {"const": "junior-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "#/$defs/payload_junior"}}},
    {"properties": {"action_kind": {"const": "checker.return-qa"}, "target_ref": {"$ref": "#/$defs/dispatch_ref"}, "profile_id": {"const": "checker-v1"}, "verifier_fence_set_sha256": {"type": "null"}, "payload": {"$ref": "#/$defs/payload_checker"}}},
    {"properties": {"action_kind": {"const": "verifier.adjudicate-report"}, "target_ref": {"$ref": "#/$defs/dispatch_ref"}, "profile_id": {"const": "verifier-v1"}, "verifier_fence_set_sha256": {"$ref": "#/$defs/sha"}, "payload": {"$ref": "#/$defs/payload_verifier"}}}
  ]
}

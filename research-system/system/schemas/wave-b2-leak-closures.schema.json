{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis-tree.local/wave-b2-leak-closures.schema.json",
  "$defs": {
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["leak_id", "status", "evidence_refs"],
      "properties": {
        "leak_id": {"enum": ["L9-01", "L9-02", "L9-03", "L9-04", "L9-05", "L9-06"]},
        "status": {"const": "closed"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"}, "uniqueItems": true}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commissioning_id", "closures"],
  "properties": {
    "schema_version": {"const": "hypothesis-tree-wave-b2-leak-closures/1.0.0"},
    "commissioning_id": {"const": "wave-b2-owned-role-v1"},
    "closures": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/closure"}, {"properties": {"leak_id": {"const": "L9-01"}}}]},
        {"allOf": [{"$ref": "#/$defs/closure"}, {"properties": {"leak_id": {"const": "L9-02"}}}]},
        {"allOf": [{"$ref": "#/$defs/closure"}, {"properties": {"leak_id": {"const": "L9-03"}}}]},
        {"allOf": [{"$ref": "#/$defs/closure"}, {"properties": {"leak_id": {"const": "L9-04"}}}]},
        {"allOf": [{"$ref": "#/$defs/closure"}, {"properties": {"leak_id": {"const": "L9-05"}}}]},
        {"allOf": [{"$ref": "#/$defs/closure"}, {"properties": {"leak_id": {"const": "L9-06"}}}]}
      ],
      "items": false
    }
  }
}

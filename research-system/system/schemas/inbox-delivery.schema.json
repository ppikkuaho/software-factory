{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis-tree.local/inbox-delivery.schema.json",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "delivery_ref": {"type": "string", "pattern": "^inbox-delivery#IB-[1-9][0-9]*$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_id", "subgoal_ref", "issue_ref", "lane", "profile_id", "task_package_ref", "task_package_sha256", "created_by_action_ref", "retry_of", "created_at"],
  "properties": {
    "schema_version": {"const": "hypothesis-tree-inbox-delivery/1.0.0"},
    "delivery_id": {"type": "string", "pattern": "^IB-[1-9][0-9]*$"},
    "subgoal_ref": {"type": "string", "pattern": "^subgoal#SG-[1-9][0-9]*$"},
    "issue_ref": {"type": "string", "pattern": "^issue#I-[1-9][0-9]*$"},
    "lane": {"const": "L4"},
    "profile_id": {"const": "l4-director-v1"},
    "task_package_ref": {"type": "string", "pattern": "^task-package#TP-[1-9][0-9]*$"},
    "task_package_sha256": {"$ref": "#/$defs/sha"},
    "created_by_action_ref": {"type": "string", "pattern": "^action-receipt#AR-[1-9][0-9]*$"},
    "retry_of": {"oneOf": [{"$ref": "#/$defs/delivery_ref"}, {"type": "null"}]},
    "created_at": {"$ref": "#/$defs/timestamp"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hypothesis-tree.local/runtime/control-request.schema.json",
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "control_id", "control_created_at", "target_daemon_incarnation_id", "operation"],
  "properties": {"schema_version": {"const": "hypothesis-tree-runtime-control-request/1.0.0"}, "control_id": {"$ref": "#/$defs/uuid"}, "control_created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}, "target_daemon_incarnation_id": {"$ref": "#/$defs/uuid"}, "operation": {"const": "stop"}}
}

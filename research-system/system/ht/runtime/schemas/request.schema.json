{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis-tree.local/runtime/request.schema.json",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "canonical_ref", "repository_relpath", "canonical_object_sha256", "raw_file_sha256", "head_blob_oid", "submission_repository_commit", "git_object_format"],
      "properties": {
        "type": {"enum": ["issue", "node", "dispatch"]},
        "canonical_ref": {"type": "string", "minLength": 1},
        "repository_relpath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "canonical_object_sha256": {"$ref": "#/$defs/sha"},
        "raw_file_sha256": {"$ref": "#/$defs/sha"},
        "head_blob_oid": {"$ref": "#/$defs/oid"},
        "submission_repository_commit": {"$ref": "#/$defs/oid"},
        "git_object_format": {"enum": ["sha1", "sha256"]}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_created_at", "role", "attempt", "retry_lineage", "work"],
  "properties": {
    "schema_version": {"const": "hypothesis-tree-runtime-request/1.0.0"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "request_created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "role": {"const": "synthetic-kernel-v1"},
    "attempt": {"type": "integer", "minimum": 1},
    "retry_lineage": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "work": {"$ref": "#/$defs/work"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hypothesis-tree.local/runtime/session-packet.schema.json",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "fence": {"type": "object", "additionalProperties": false, "required": ["binding_id", "lease_epoch", "session_id"], "properties": {"binding_id": {"$ref": "#/$defs/uuid"}, "lease_epoch": {"type": "integer", "minimum": 1}, "session_id": {"$ref": "#/$defs/uuid"}}},
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "canonical_ref", "repository_relpath", "canonical_object_sha256", "raw_file_sha256", "head_blob_oid", "submission_repository_commit", "git_object_format"],
      "properties": {"type": {"enum": ["issue", "node", "dispatch"]}, "canonical_ref": {"type": "string", "minLength": 1}, "repository_relpath": {"type": "string", "minLength": 1}, "canonical_object_sha256": {"$ref": "#/$defs/sha"}, "raw_file_sha256": {"$ref": "#/$defs/sha"}, "head_blob_oid": {"$ref": "#/$defs/oid"}, "submission_repository_commit": {"$ref": "#/$defs/oid"}, "git_object_format": {"enum": ["sha1", "sha256"]}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "request_id", "binding_id", "node_address", "lease_epoch", "session_id", "fence", "role", "attempt", "retry_lineage", "work", "admission_repository_commit", "wrapper_instance_id", "helper_instance_id", "packet_created_at"],
  "properties": {
    "schema_version": {"const": "hypothesis-tree-runtime-session-packet/1.0.0"}, "runtime_id": {"$ref": "#/$defs/uuid"}, "request_id": {"$ref": "#/$defs/uuid"}, "binding_id": {"$ref": "#/$defs/uuid"}, "node_address": {"type": "string", "minLength": 1}, "lease_epoch": {"type": "integer", "minimum": 1}, "session_id": {"$ref": "#/$defs/uuid"}, "fence": {"$ref": "#/$defs/fence"},
    "role": {"const": "synthetic-kernel-v1"}, "attempt": {"type": "integer", "minimum": 1}, "retry_lineage": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true}, "work": {"$ref": "#/$defs/work"}, "admission_repository_commit": {"$ref": "#/$defs/oid"}, "wrapper_instance_id": {"$ref": "#/$defs/uuid"}, "helper_instance_id": {"$ref": "#/$defs/uuid"}, "packet_created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}

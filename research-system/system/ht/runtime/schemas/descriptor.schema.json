{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypothesis-tree.local/runtime/descriptor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_kind", "build_id", "runtime_id", "runtime_root", "repository_root", "created_at"],
  "properties": {
    "schema_version": {"const": "hypothesis-tree-runtime/1.0.0"},
    "runtime_kind": {"const": "hypothesis-tree"},
    "build_id": {"const": "ht-runtime-kernel/1.0.0"},
    "runtime_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "runtime_root": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  }
}
